[Unit]
Description=ПК «Кафедра» — система управления обучением
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kafedra
Group=kafedra
ExecStart=/opt/kafedra/kafedra serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536

# Изоляция процесса средствами systemd
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
# «-» перед путём: отсутствие каталога не мешает запуску службы
ReadWritePaths=-/opt/kafedra/data -/opt/kafedra/config.json -/var/log/kafedra
UMask=0077

[Install]
WantedBy=multi-user.target
